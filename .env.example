# Neon Postgres (https://console.neon.tech) -- misma instancia que startup-advisor
# y ontology-engine, schema propio (next_action_*). Historial de migraciones
# independiente: no importar drizzle de startup-advisor.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ontology-engine (https://ontology-engine.fly.dev en producción)
ONTOLOGY_ENGINE_URL=http://localhost:8001

# API keys por invocador (sección 3 del diseño): app (startup-advisor,
# server-side) y hermes (asistente agéntico local). Sin tabla
# next_action_api_keys todavía -- rotación manual vía env var + redeploy.
API_KEY_APP=
API_KEY_HERMES=

# Administración de allowed_emails (sección 9) -- solo protege /admin/*
# (excepto /admin/allowed-emails/check, que usa API_KEY_APP: lo consume
# el flujo normal del magic link, no un administrador).
API_KEY_ADMIN=

# Claude (sección 7): modelo y API key configurables por nodo del grafo,
# sin tocar código. Si *_MODEL no está seteada, cae al default confirmado
# (orquestador: claude-opus-4-8, validador y especialista: claude-sonnet-5).
# Si *_ANTHROPIC_API_KEY no está seteada, cae a ANTHROPIC_API_KEY general.
ANTHROPIC_API_KEY=
ORCHESTRATOR_MODEL=
ORCHESTRATOR_ANTHROPIC_API_KEY=
VALIDATOR_MODEL=
VALIDATOR_ANTHROPIC_API_KEY=
SPECIALIST_MODEL=
SPECIALIST_ANTHROPIC_API_KEY=

# Multi-proveedor (prueba real): por ahora solo el orquestador soporta
# provider="google" (Gemini API, @langchain/google-genai) además del
# default "anthropic" -- validador y especialista siguen fijos en Anthropic.
# Si ORCHESTRATOR_PROVIDER=google, ORCHESTRATOR_MODEL es obligatorio (ej.
# gemma-4-26b-a4b-it) -- no hay default cross-provider -- y se usa
# ORCHESTRATOR_GOOGLE_API_KEY, no ORCHESTRATOR_ANTHROPIC_API_KEY.
ORCHESTRATOR_PROVIDER=
ORCHESTRATOR_GOOGLE_API_KEY=

# Voyage AI (sección 4): único proveedor de embeddings para el RAG (Claude
# no los genera). Usado por el especialista para embeber la consulta al
# buscar en rag_chunks, y por el notebook de ingesta offline para embeber
# los chunks de los libros base.
VOYAGE_API_KEY=

# Verificacion de firma Ed25519 de los PDF exportados por startup-advisor
# (seccion 9). No es secreta -- la privada vive solo en startup-advisor.
PDF_SIGNING_PUBLIC_KEY=

PORT=8000
